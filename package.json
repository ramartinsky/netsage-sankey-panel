{
  "name": "grafana-sankey-rainbow",
  "version": "1.0.0",
  "description": "Sankey Rainbow panel plugin for Grafana",
  "license": "Apache-2.0",
  "repository": "https://github.com/ramartinsky/grafana-sankey-rainbow",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "start": "yarn dev",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Live Reply"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "^12.2.0",
    "@grafana/i18n": "^12.2.0",
    "@grafana/runtime": "^12.2.0",
    "@grafana/schema": "^12.2.0",
    "@grafana/ui": "^12.2.0",
    "d3": ">=7.0.0 <8.0.0",
    "d3-sankey": "0.12.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tslib": "2.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/d3": "7.0.0",
    "@types/d3-sankey": "0.11.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.188",
    "@types/node": "^20.8.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.0",
    "typescript": "5.5.4",
    "webpack": "^5.106.0",
