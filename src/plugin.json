{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Sankey Rainbow",
  "id": "livereply-sankeyrainbow-panel",
  "info": {
    "description": "Sankey diagrams for flow data, with node colors driven by Grafana value mappings",
    "author": {
      "name": "Live Reply",
      "url": "https://github.com/ramartinsky/grafana-sankey-rainbow"
    },
    "keywords": ["sankey", "flow", "diagram", "panel", "value mappings"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/ramartinsky/grafana-sankey-rainbow"
      },
      {
        "name": "License",
        "url": "https://github.com/ramartinsky/grafana-sankey-rainbow/blob/master/LICENSE"
      }
    ],
    "screenshots": [
      { "name": "Sankey by country", "path": "img/sankey2.png" },
      { "name": "Multi-column Sankey", "path": "img/sankey3.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.2.0",
    "plugins": []
  }
}
